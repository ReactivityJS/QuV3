{
  "name": "chat",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Chat",
  "icon": "💭",
  "navOrder": 11,
  "spaceId": "39d30ff2-be01-4277-93a5-85d21b4ce096",
  "requires": [],
  "pushActions": [
    { "id": "newMessage", "label": "New messages", "type": "create" },
    { "id": "mention", "label": "Mentions", "type": "mention" }
  ],
  "actions": [
    { "slot": "contact-row", "id": "chat", "label": "Chat", "icon": "💬", "hrefTemplate": "#/chat/{pub}" }
  ],
  "definesExtensionPoints": [
    { "point": "content.chatRoomMenu", "kind": "menu", "description": "The room header's own \"⋮\" menu (Mute is this app's own native item, not a contributor - see client.js's own mountRoomView() doc comment). Payload: {services, qu, syncFetch, spaceId, threadId, memberPubs, contactPub}. contactPub is null for a group (Phone's own call items only make sense for a 1:1 room). Returns {id, label, icon, onClick} (or an array of those)." }
  ],
  "contributes": [
    { "point": "userSettings.contributions", "export": "renderChatSettings", "kind": "ui", "order": 20 },
    { "point": "content.search", "export": "searchChat", "kind": "query" },
    { "point": "content.searchResultTemplate", "export": "renderSearchResult", "kind": "ui" },
    { "point": "content.resolveReference", "export": "resolveChatReference", "kind": "query" }
  ]
}
