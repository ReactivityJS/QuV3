{
  "name": "forum",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Forum",
  "icon": "💬",
  "navOrder": 10,
  "spaceId": "4eb04aa2-4ca9-4c9a-aa7e-33ad3802edb1",
  "requires": ["message-service"],
  "pushActions": [
    { "id": "newMessage", "label": "New posts", "type": "create" },
    { "id": "mention", "label": "Mentions", "type": "mention" }
  ],
  "definesExtensionPoints": [
    { "point": "content.messageFooter", "kind": "ui", "description": "The per-message footer ROW (menu trigger, timestamp, reactions - order admin-configurable via relay-settings' extensionOrder) - e.g. Reactions' own widget. Payload: {services, qu, syncFetch, spaceId, threadId, messageId, myPub, mine, body, author}." },
    { "point": "content.messageMenu", "kind": "menu", "description": "This message's own \"⋮\" context menu - e.g. Pins'/Bookmarks' own toggle, each one entry. Payload: {services, qu, syncFetch, spaceId, threadId, messageId, myPub, mine, body, author}. Returns {id, label, icon, onClick}." },
    { "point": "content.topicToolbar", "kind": "ui", "description": "Rendered ONCE per topic/room view, above the message list - e.g. Pins' own \"Pinned\" bar. Shared by Chat's and Forum's own view (host-agnostic, like content.composerActions). Payload: {services, qu, syncFetch, spaceId, threadId, messagePermalink: (messageId) => string}." },
    { "point": "content.composerActions", "kind": "menu", "description": "The composer's own \"+\" action menu (Attach, plus whatever a plugin app contributes - e.g. a Calendar/Gallery app's own entry, or a game's own \"share\" action). Shared by Chat's and Forum's composer. Payload: {services, qu, syncFetch, spaceId, threadId}. Returns {id, label, icon, onClick}." },
    { "point": "content.entityFooter", "kind": "ui", "description": "Rendered ONCE in a topic's own header, below its opening content - e.g. Reactions' own widget, reacting to the topic ITSELF (not a comment). Payload: {services, qu, syncFetch, spaceId, entityId, myPub}." },
    { "point": "content.entityMenu", "kind": "menu", "description": "The topic's own content menu - e.g. Bookmarks' own toggle for the topic itself. Payload: {services, entityId, snapshot}. Returns {id, label, icon, onClick}." }
  ],
  "contributes": [
    { "point": "content.search", "export": "searchForum", "kind": "query" },
    { "point": "content.searchResultTemplate", "export": "renderSearchResult", "kind": "ui" },
    { "point": "content.resolveReference", "export": "resolveForumReference", "kind": "query" }
  ]
}
