{
  "name": "forum",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Forum",
  "icon": "💬",
  "navOrder": 10,
  "spaceId": "4eb04aa2-4ca9-4c9a-aa7e-33ad3802edb1",
  "requires": ["message-service"],
  "pushActions": [
    { "id": "newMessage", "label": "New posts", "type": "create" },
    { "id": "mention", "label": "Mentions", "type": "mention" }
  ],
  "definesExtensionPoints": [
    { "point": "content.messageActions", "kind": "ui", "description": "Extra action buttons per forum message - e.g. Bookmarks' toggle. Payload: {services, messageId, spaceId, threadId, body, author}." },
    { "point": "content.messagePinToggle", "kind": "ui", "description": "The Pin/Unpin toggle for a forum message - e.g. Pins' own toggle. Payload: {services, qu, syncFetch, spaceId, threadId, messageId}." },
    { "point": "content.messageReactions", "kind": "ui", "description": "The emoji-reaction row for a forum message - e.g. Reactions' own widget. Payload: {services, qu, syncFetch, spaceId, threadId, messageId, myPub}." },
    { "point": "forum.topicToolbar", "kind": "ui", "description": "Rendered ONCE per topic view, above the message list - e.g. Pins' own \"Pinned\" bar. Payload: {services, qu, syncFetch, spaceId, threadId}." }
  ],
  "contributes": [
    { "point": "content.search", "export": "searchForum", "kind": "query" },
    { "point": "content.searchResultTemplate", "export": "renderSearchResult", "kind": "ui" }
  ]
}
