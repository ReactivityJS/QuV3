{
  "name": "notifications",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Notifications",
  "icon": "🔔",
  "navOrder": 12,
  "requires": [],
  "definesExtensionPoints": [
    { "point": "content.resolveReference", "kind": "query", "description": "Resolves a stored notification's live {spaceId, threadId, messageId} reference back into a content.search-shaped entry, so the SAME content.searchResultTemplate contributor Search uses can render it here too. Payload: {services, qu, syncFetch, myPub, spaceId, threadId, messageId}. Called via ExtensionPointHost.collect(point, payload, {onlyAppId: notification.appId}) - exactly one contributor. Returns one entry object (or null/nothing if unresolvable - deleted message, no access, disabled app), same shape content.search's entries use." }
  ]
}
