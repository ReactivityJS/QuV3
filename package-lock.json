      "resolved": "packages/foundation",
      "link": true
    },
    "packages/core": {
      "name": "@qu/core",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/foundation": {
      "name": "@qu/foundation",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
